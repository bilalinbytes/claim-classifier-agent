# Provider Configuration (Options: gemini, openai, anthropic, fake)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Place your key in your private .env file; NEVER commit keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution Settings
TIMEOUT_SECONDS=30.0
MAX_TURNS=3

# Database URL for FastAPI persistence (PostgreSQL or SQLite)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/kasparro
# Example SQLite fallback: sqlite:///kasparro.db
DATABASE_URL=sqlite:///kasparro.db
